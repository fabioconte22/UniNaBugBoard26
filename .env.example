# Copia questo file in .env (che git ignora) e cambia i valori: docker compose li legge da solo.
# Senza .env valgono i valori di sviluppo, che vanno bene solo in locale.

# Password del database (la usano Postgres e i tre servizi).
DB_PASSWORD=cambiami
# Password di RabbitMQ (la usano RabbitMQ, issue-service e notification-service).
RABBITMQ_PASSWORD=cambiami
# Segreto con cui user-service firma i token e gli altri servizi li verificano:
# almeno 32 byte casuali in Base64, per esempio da: openssl rand -base64 48
JWT_SECRET=
# Account amministratore creato al primo avvio.
ADMIN_EMAIL=admin@bugboard26.com
ADMIN_PASSWORD=cambiami
# Indirizzo pubblico dell'app (es. quello di CloudFront), separati da virgola se più d'uno.
# CORS_ALLOWED_ORIGINS=https://xxxx.cloudfront.net
# Porta della macchina da cui si apre l'applicazione (predefinita: 80).
# FRONTEND_PORT=8000
